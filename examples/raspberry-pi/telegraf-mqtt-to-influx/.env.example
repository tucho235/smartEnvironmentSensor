# Copy this file to .env on the Raspberry Pi and replace every CHANGE_ME value.

# Existing InfluxDB 2 instance.
# If Telegraf joins the same Docker network as InfluxDB, use the InfluxDB
# service/container name, for example: http://influxdb:8086
INFLUX_URL=http://host.docker.internal:8086
INFLUX_TOKEN=CHANGE_ME_INFLUX_TOKEN
INFLUX_ORG=smart-home
INFLUX_BUCKET=smart_environment

# Existing Mosquitto broker.
MQTT_SERVER=tcp://host.docker.internal:1883
MQTT_USERNAME=esp32
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD
MQTT_TOPIC=smart-environment-sensor/#
