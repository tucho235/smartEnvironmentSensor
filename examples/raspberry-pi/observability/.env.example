# Copy this file to .env on the Raspberry Pi and replace every CHANGE_ME value.

INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME_INFLUX_ADMIN_PASSWORD
INFLUXDB_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_INFLUX_TOKEN
INFLUXDB_ORG=smart-home
INFLUXDB_BUCKET=smart_environment

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# If Mosquitto runs on the same Raspberry Pi and exposes port 1883, keep this.
MQTT_SERVER=tcp://host.docker.internal:1883
MQTT_USERNAME=esp32
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD
MQTT_TOPIC=smart-environment-sensor/#
