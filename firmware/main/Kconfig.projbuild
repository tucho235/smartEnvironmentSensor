menu "Smart Environment Sensor Configuration"

    config APP_WIFI_PROV_SERVICE_PREFIX
        string "BLE provisioning service name prefix"
        default "SMENV_"
        help
            Prefix used to build the BLE device name shown by the provisioning
            app. The last three bytes of the Wi-Fi MAC are appended.

    config APP_WIFI_PROV_POP
        string "BLE provisioning proof of possession"
        default ""
        help
            Optional local proof of possession for provisioning security 1.
            Leave empty for initial development. If set, keep it only in the
            ignored local sdkconfig file and do not add it to sdkconfig.defaults.

    config APP_WIFI_PROV_MAX_ATTEMPTS
        int "Maximum provisioning Wi-Fi connection attempts"
        default 5
        range 1 20
        help
            Number of connection attempts the provisioning manager may use when
            testing newly received Wi-Fi credentials.

    config APP_MQTT_BROKER_URI
        string "MQTT broker URI"
        default ""
        help
            Local MQTT broker URI, for example mqtt://192.168.3.10:1883.
            Leave empty to keep MQTT telemetry disabled. This value is written
            to sdkconfig, which is ignored by Git.

    config APP_MQTT_USERNAME
        string "MQTT username"
        default ""
        help
            Optional MQTT username. This value is written to sdkconfig, which is
            ignored by Git. Do not add credentials to sdkconfig.defaults.

    config APP_MQTT_PASSWORD
        string "MQTT password"
        default ""
        help
            Optional MQTT password. This value is written to sdkconfig, which is
            ignored by Git. Do not add credentials to sdkconfig.defaults.

    config APP_MQTT_TELEMETRY_TOPIC
        string "MQTT telemetry topic"
        default "smart-environment-sensor/bme680/state"
        help
            Topic used for periodic BME680 telemetry snapshots.

    config APP_MQTT_PUBLISH_INTERVAL_MS
        int "MQTT telemetry publish interval in milliseconds"
        default 10000
        range 1000 3600000
        help
            Interval used by the MQTT telemetry task. This is independent from
            the BME680 sampling interval.

    config APP_MQTT_RECONNECT_INTERVAL_MS
        int "MQTT broker reconnect interval in milliseconds"
        default 10000
        range 1000 3600000
        help
            Broker reconnect interval used by the ESP-MQTT client.

endmenu
