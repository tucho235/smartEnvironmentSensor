CONFIG_APP_ENABLE_MATTER=y
# CONFIG_APP_MATTER_THERMOSTAT_ONLY is not set
# CONFIG_APP_MATTER_TEMPERATURE_ONLY is not set
# CONFIG_APP_MATTER_SEPARATE_SENSOR_ENDPOINTS is not set
# CONFIG_APP_MATTER_ENABLE_POWER_SOURCE is not set
CONFIG_APP_ENABLE_MQTT_TELEMETRY=y
CONFIG_APP_ENABLE_CONFIG_PORTAL=y

# Keep Matter Wi-Fi commissioning enabled and let ESP-Matter own station
# connection attempts during this validation build.
# CONFIG_CUSTOM_NETWORK_CONFIG is not set

# ESP32-C3 SuperMini is used as a Wi-Fi Matter device in this project.
# CONFIG_ESP_MATTER_ENABLE_OPENTHREAD is not set

CONFIG_USE_LWIP_PBUF_RAM_PACKETBUFFER=y
CONFIG_MAX_EXCHANGE_CONTEXTS=4
CONFIG_NUM_TCP_ENDPOINTS=4
CONFIG_NUM_UDP_ENDPOINTS=4
